{
  "name": "mapclay",
  "description": "Create interactive maps by simple options",
  "version": "0.10.1",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "module": "index.mjs",
  "sideEffects": [
    "./dist/renderers/*.mjs",
    "./src/BasicLeafletRenderer.mjs",
    "./src/BasicMaplibreRenderer.mjs",
    "./src/BasicOpenlayersRenderer.mjs"
  ],
  "files": [
    "index.mjs",
    "dist/**",
    "src/**",
    "assets/**"
  ],
  "keywords": [
    "map",
    "yaml"
  ],
  "scripts": {
    "watch": "npx rollup -c scripts/rollup.config.js -w",
    "build": "npx rollup -c scripts/rollup.config.js",
    "lint": "eslint --fix .",
    "docs": "jsdoc -c scripts/jsdoc.conf src/;",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.39.5",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "neostandard": "^0.13.0",
    "rollup": "^4.62.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "js-yaml": "^5.2.3",
    "leaflet": "2.0.0-alpha.1",
    "maplibre-gl": "^6.1.0",
    "maplibre-gl-vector-text-protocol": "github:jimmyrocks/maplibre-gl-vector-text-protocol",
    "ol": "^10.10.0",
    "proj4": "^2.20.9",
    "terra-draw": "^1.32.2",
    "terra-draw-leaflet-adapter": "^1.2.0",
    "terra-draw-maplibre-gl-adapter": "^1.3.0",
    "terra-draw-openlayers-adapter": "latest"
  },
  "author": "Hsiehg Chin Fan <pham@topo.tw>",
  "homepage": "https://outdoorsafetylab.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/outdoorsafetylab/mapclay"
  },
  "prettier": {
    "arrowParens": "avoid"
  }
}
